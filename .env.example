# Flask
SECRET_KEY=replace-with-a-long-random-secret
FLASK_DEBUG=0

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-server-key

# Gemini
# Use one key or multiple comma-separated keys for failover.
GEMINI_API_KEYS=your-gemini-key-1,your-gemini-key-2
GEMINI_MODEL=gemini-2.5-flash

# Optional Google Custom Search image support
# Leave blank to disable image search without affecting AI answers.
GOOGLE_API_KEY=
SEARCH_ENGINE_ID=
