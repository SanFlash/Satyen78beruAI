# Flask
SECRET_KEY=replace-with-a-long-random-secret
FLASK_DEBUG=0

# Supabase (server-side only)
SUPABASE_URL=https://your-project.supabase.co
# Prefer the new Supabase secret key (sb_secret_...). Never expose it in frontend code.
SUPABASE_KEY=replace-with-your-supabase-secret-key

# Gemini
# Use one key or multiple comma-separated keys for failover.
# Keep real keys only in your local .env / hosting provider environment variables.
GEMINI_API_KEYS=your-gemini-key-1,your-gemini-key-2
# Current production model used by this project.
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional Google Custom Search image support
# Leave blank to disable image search without affecting AI answers.
GOOGLE_API_KEY=
SEARCH_ENGINE_ID=

# Code Runner
# Required for JavaScript, C, C++, and Java through the hosted Piston service.
# The public Piston API now requires authorization.
PISTON_API_KEY=
# Optional: use your own/self-hosted Piston endpoint instead.
PISTON_API_URL=https://emkc.org/api/v2/piston/execute
